# 编辑器基础规范,与 .gitattributes 配合使用
# .gitattributes 管 Git 的行尾转换,.editorconfig 管编辑器的缩进与编码

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
